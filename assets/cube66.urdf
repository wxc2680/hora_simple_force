<?xml version="1.0"?>
<robot name="cube66">
  <link name="cube66">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.066 0.066 0.066"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.066 0.066 0.066"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.0651581"/>
      <inertia ixx="2.36524e-5" ixy="0.0" ixz="0.0"
               iyy="2.36524e-5" iyz="0.0"
               izz="2.36524e-5"/>
    </inertial>
  </link>

  <joint name="fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
</robot>
