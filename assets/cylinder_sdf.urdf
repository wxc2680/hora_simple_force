<?xml version="1.0"?>
<robot name="cylinder_sdf">
  <link name="cylinder">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/cylinder_50x35mm.obj"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/cylinder_50x35mm.obj"/>
      </geometry>
      <sdf resolution="256"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.2917e-5" ixy="0.0" ixz="0.0"
               iyy="1.2917e-5" iyz="0.0"
               izz="1.5625e-5"/>
    </inertial>
  </link>
</robot>
