      <sdf resolution="256"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.04729"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
</robot>
