<?xml version="1.0"?>
<robot name="ball_sdf">
  <link name="ball">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/sphere_20mm.obj" scale="1.5 1.5 1.5"/>
