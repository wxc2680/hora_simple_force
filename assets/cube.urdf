<?xml version="1.0"?>
<robot name="cube">
  <link name="cube">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.02833"/>
      <inertia ixx="5.9020833e-6" ixy="0.0" ixz="0.0"
               iyy="5.9020833e-6" iyz="0.0"
               izz="5.9020833e-6"/>
    </inertial>
  </link>

  <joint name="fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
</robot>