<?xml version="1.0"?>
<robot name="cube_sdf">
  <link name="cube">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/cube_50mm.obj"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/cube_50mm.obj"/>
      </geometry>
      <sdf resolution="256"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02833"/>
      <inertia ixx="5.9020833e-6" ixy="0.0" ixz="0.0"
               iyy="5.9020833e-6" iyz="0.0"
               izz="5.9020833e-6"/>
    </inertial>
  </link>
</robot>
