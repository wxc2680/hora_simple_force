<?xml version="1.0"?>
<robot name="cube25_sdf">
  <link name="cube25">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/cube25_25mm.obj"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="sdf/cube25_25mm.obj"/>
      </geometry>
      <sdf resolution="256"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.00354"/>
      <inertia ixx="1.844e-7" ixy="0.0" ixz="0.0"
               iyy="1.844e-7" iyz="0.0"
               izz="1.844e-7"/>
    </inertial>
  </link>
</robot>
